// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String             @id @default(uuid())
  email     String             @unique
  name      String?
  avatarUrl String?
  password  String
  refreshToken String?
  sessions  InterviewSession[] @relation("HostSessions")
  createdAt DateTime           @default(now())
}

model Question {
  id               String             @id @default(uuid())
  title            String
  description      String // markdown or HTML
  defaultCode      Json? // sample starter code by language
  tests            Json? // serializable testcases
  difficulty       String?
  createdAt        DateTime           @default(now())
  InterviewSession InterviewSession[]
}

model InterviewSession {
  id           String        @id @default(uuid())
  hostId       String
  host         User          @relation("HostSessions", fields: [hostId], references: [id])
  guestId      String?
  questionId   String?
  question     Question?     @relation(fields: [questionId], references: [id])
  status       SessionStatus @default(PENDING) // PENDING, ACTIVE, FINISHED
  startedAt    DateTime?
  endedAt      DateTime?
  codeSnippets CodeSnippet[]
  chatMessages ChatMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Submission   Submission[]
}

enum SessionStatus {
  PENDING
  ACTIVE
  FINISHED
}

model CodeSnippet {
  id        String           @id @default(uuid())
  session   InterviewSession @relation(fields: [sessionId], references: [id])
  sessionId String
  userId    String?
  language  String
  content   String // current text or entire file content
  snapshot  Json? // optional persisted CRDT snapshot (binary encoded as base64/JSON)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ChatMessage {
  id        String           @id @default(uuid())
  session   InterviewSession @relation(fields: [sessionId], references: [id])
  sessionId String
  userId    String
  text      String
  createdAt DateTime         @default(now())
}

model Submission {
  id        String           @id @default(uuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id])
  userId    String
  codeId    String? // link to CodeSnippet
  language  String
  result    Json? // judge output / tests pass/fail
  createdAt DateTime         @default(now())
}
